# Build configuration for Typst project
rule typst_compile
  depfile = $in.d
  command = typst compile --deps $in.d --deps-format make $in
  description = Compile Typst document $in

rule typst_watch
  command = typst watch $in
  description = Watch and auto-compile $in

rule pack_7z
  command = 7z a -t7z -m0=lzma2 -mx=9 $out $in
  description = Pack all PDF files into $out

# Build targets
build ch1-language-fa-regex.pdf: typst_compile ch1-language-fa-regex.typ
build ch2-cfl.pdf: typst_compile ch2-cfl.typ
build ch3-turing-machine.pdf: typst_compile ch3-turing-machine.typ
build ch4-decidability.pdf: typst_compile ch4-decidability.typ
build supplementary-exercises.pdf: typst_compile supplementary-exercises.typ
build exam-2023-2024.pdf: typst_compile exam-2023-2024.typ
build preview.pdf: typst_compile preview.typ

build all.7z: pack_7z ch1-language-fa-regex.pdf ch2-cfl.pdf ch3-turing-machine.pdf ch4-decidability.pdf supplementary-exercises.pdf exam-2023-2024.pdf preview.pdf

default all.7z
